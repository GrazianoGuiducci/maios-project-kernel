{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maios.it/schemas/competence-formation-candidate-v1.json",
  "title": "MAIOS competence formation candidate",
  "$comment": "This is a project-local form for later exercise. It is not an admitted competence, a closed taxonomy, or self-granted authority.",
  "type": "object",
  "required": [
    "candidate_id",
    "form",
    "purpose",
    "work_relation",
    "source_refs",
    "activation_relations",
    "invalidator",
    "reentry_condition",
    "next_exercise"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "form": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "work_relation": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "activation_relations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "invalidator": {"type": "string", "minLength": 1},
    "reentry_condition": {"type": "string", "minLength": 1},
    "next_exercise": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

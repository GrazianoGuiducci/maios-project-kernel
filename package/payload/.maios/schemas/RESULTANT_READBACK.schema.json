{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maios.it/schemas/resultant-readback-v3.json",
  "title": "MAIOS forward-resultant readback",
  "$comment": "This interoperable shape preserves the actual resultant and any owner-bound causal learning without imposing a review or admission stage. External claims and material effects retain their exact local evidence and authority boundaries.",
  "type": "object",
  "required": ["schema", "event_id", "observed_at", "movement", "source_positions", "candidate_resultant", "preprojection_readback", "actual_result", "faculty_deltas", "possibility_impact", "next_movement", "effect", "causal_margin", "learning_deltas"],
  "properties": {
    "schema": {"const": "maios.resultant-readback.v3"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "observed_at": {"type": "string", "minLength": 1},
    "movement": {"type": "object"},
    "source_positions": {
      "type": "object",
      "required": ["operator_source", "verified_evidence", "model_inference", "retained_unknowns"],
      "properties": {
        "operator_source": {"$ref": "#/$defs/stringList"},
        "verified_evidence": {"$ref": "#/$defs/stringList"},
        "model_inference": {"$ref": "#/$defs/stringList"},
        "retained_unknowns": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "candidate_resultant": {
      "type": "object",
      "required": ["summary"],
      "properties": {"summary": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "preprojection_readback": {
      "type": "object",
      "required": ["status", "description", "corrections"],
      "properties": {
        "status": {"enum": ["preserved", "corrected", "noncollapse"]},
        "description": {"type": "string", "minLength": 1},
        "corrections": {"$ref": "#/$defs/stringList"},
        "semantic_sensitivity": {
          "type": "object",
          "required": ["status", "description", "source_refs"],
          "properties": {
            "status": {"enum": ["not_material", "preserved", "corrected", "noncollapse"]},
            "description": {"type": "string", "minLength": 1},
            "source_refs": {"$ref": "#/$defs/stringList"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "actual_result": {
      "type": "object",
      "required": ["status", "summary", "evidence_refs"],
      "properties": {
        "status": {"enum": ["completed", "partial", "blocked", "failed", "deferred"]},
        "classification": {"$ref": "#/$defs/classification"},
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "faculty_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["faculty_id", "description"],
        "properties": {
          "faculty_id": {"type": "string", "minLength": 1},
          "classification": {"$ref": "#/$defs/classification"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "possibility_impact": {
      "type": "object",
      "required": ["opened", "preserved", "constrained", "eliminated"],
      "properties": {
        "opened": {"$ref": "#/$defs/stringList"},
        "preserved": {"$ref": "#/$defs/stringList"},
        "constrained": {"$ref": "#/$defs/stringList"},
        "eliminated": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "next_movement": {
      "type": "object",
      "required": ["current_next", "reason", "reentry_condition", "relations"],
      "properties": {
        "current_next": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reentry_condition": {"type": "string", "minLength": 1},
        "relations": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["status", "boundary", "receipt_refs"],
      "properties": {
        "status": {"enum": ["none", "effect_unbound", "effect_bound"]},
        "boundary": {"type": ["object", "null"]},
        "receipt_refs": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "causal_margin": {
      "type": "object",
      "required": ["operator_relation", "selected_object", "owner_surface", "last_faithful_resultant", "current_movement", "next_movement", "supersession_condition"],
      "properties": {
        "operator_relation": {"type": "string", "minLength": 1},
        "selected_object": {"type": "string", "minLength": 1},
        "owner_surface": {"type": "string", "minLength": 1},
        "last_faithful_resultant": {"type": "string", "minLength": 1},
        "current_movement": {"type": "string", "minLength": 1},
        "next_movement": {"type": "string", "minLength": 1},
        "supersession_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "front_transition": {
      "type": "object",
      "required": ["upserts", "remove_ids", "focus_id"],
      "properties": {
        "upserts": {
          "type": "array",
          "items": {"$ref": "#/$defs/openFront"}
        },
        "remove_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        },
        "focus_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          ]
        }
      },
      "additionalProperties": true
    },
    "learning_deltas": {
      "type": "array",
      "items": {"$ref": "#/$defs/learningDelta"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "classification": {
      "enum": ["verified_improvement", "no_change", "regression", "tradeoff", "unverified"]
    },
    "openFront": {
      "type": "object",
      "required": ["id", "title", "owner_surface", "status", "last_faithful_resultant", "current_movement", "next_movement", "reentry_condition", "supersession_condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "owner_surface": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "last_faithful_resultant": {"type": "string", "minLength": 1},
        "current_movement": {"type": "string", "minLength": 1},
        "next_movement": {"type": "string", "minLength": 1},
        "reentry_condition": {"type": "string", "minLength": 1},
        "supersession_condition": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": true
    },
    "learningDelta": {
      "type": "object",
      "required": ["owner", "what_happened", "causal_delta", "why_it_matters", "future_behavior", "source_refs", "activation_relations", "invalidator", "reentry_condition"],
      "properties": {
        "owner": {
          "type": "object",
          "required": ["kind", "id", "owner"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "what_happened": {"type": "string", "minLength": 1},
        "causal_delta": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "future_behavior": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/stringList"},
        "activation_relations": {"$ref": "#/$defs/nonEmptyStringList"},
        "invalidator": {"type": "string", "minLength": 1},
        "reentry_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

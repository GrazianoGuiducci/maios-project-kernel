{
  "description": "Project-local source-bound lifecycle competence projection.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "additionalContextLimit": 700,
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "statusMessage": "Reading back the produced result",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "additionalContextLimit": 700,
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "statusMessage": "Checking mutation source continuity",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 700,
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "statusMessage": "Orienting project lifecycle context",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "statusMessage": "Completing project-result verification",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "additionalContextLimit": 700,
            "command": "python3 '.codex/hooks/project_hook_kernel.py'",
            "commandWindows": "python \".codex\\hooks\\project_hook_kernel.py\"",
            "statusMessage": "Preserving operator source and project evidence",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
